{
	"__inputs": [
		{
			"name": "DS_PROMETHEUS",
			"label": "Managed Prometheus",
			"description": "Select the Azure Monitor Workspace / Managed Prometheus data source (e.g., Managed_Prometheus_mon-bwc-asc-vminsights-weu)",
			"type": "datasource",
			"pluginId": "prometheus",
			"pluginName": "Prometheus"
		}
	],
	"__requires": [
		{
			"type": "grafana",
			"id": "grafana",
			"name": "Grafana",
			"version": "11.0.0"
		},
		{
			"type": "datasource",
			"id": "prometheus",
			"name": "Prometheus",
			"version": "1.0.0"
		},
		{
			"type": "panel",
			"id": "stat",
			"name": "Stat",
			"version": ""
		},
		{
			"type": "panel",
			"id": "timeseries",
			"name": "Time series",
			"version": ""
		},
		{
			"type": "panel",
			"id": "table",
			"name": "Table",
			"version": ""
		},
		{
			"type": "panel",
			"id": "text",
			"name": "Text",
			"version": ""
		}
	],
	"annotations": {
		"list": [
			{
				"builtIn": 1,
				"datasource": {
					"type": "grafana",
					"uid": "-- Grafana --"
				},
				"enable": true,
				"hide": true,
				"iconColor": "rgba(0, 211, 255, 1)",
				"name": "Annotations & Alerts",
				"type": "dashboard"
			}
		]
	},
	"editable": true,
	"fiscalYearStartMonth": 0,
	"graphTooltip": 1,
	"id": null,
	"links": [],
	"liveNow": false,
	"panels": [
		{
			"type": "text",
			"title": "About (OTel metric names)",
			"gridPos": {
				"h": 4,
				"w": 24,
				"x": 0,
				"y": 0
			},
			"options": {
				"mode": "markdown",
				"content": "This dashboard uses **OpenTelemetry system/process metrics** stored in an **Azure Monitor Workspace (Managed Prometheus)**.\n\nMicrosoft recommends quoting OTel metric names with dots when using PromQL in Azure Monitor, for example: `{\\\"system.cpu.utilization\\\"}` and quoting label names with dots like `\"Microsoft.resourceid\"`.\n\nSelect a VM via the **Resource** variable (it uses the `\"Microsoft.resourceid\"` label)."
			},
			"transparent": true
		},
		{
			"type": "stat",
			"title": "Uptime",
			"datasource": {
				"type": "prometheus",
				"uid": "${DS_PROMETHEUS}"
			},
			"gridPos": {
				"h": 4,
				"w": 6,
				"x": 0,
				"y": 4
			},
			"targets": [
				{
					"expr": "{\"system.uptime\", \"Microsoft.resourceid\"=~\"$resourceId\"}",
					"legendFormat": "",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s",
					"decimals": 0
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"fields": "",
					"values": false
				},
				"orientation": "auto",
				"textMode": "auto",
				"colorMode": "value",
				"graphMode": "none",
				"justifyMode": "auto"
			}
		},
		{
			"type": "stat",
			"title": "CPU Utilization (non-idle)",
			"datasource": {
				"type": "prometheus",
				"uid": "${DS_PROMETHEUS}"
			},
			"gridPos": {
				"h": 4,
				"w": 6,
				"x": 6,
				"y": 4
			},
			"targets": [
				{
					"expr": "100 * (1 - avg({\"system.cpu.utilization\", state=\"idle\", \"Microsoft.resourceid\"=~\"$resourceId\"}))",
					"legendFormat": "",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"decimals": 1,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "green",
								"value": null
							},
							{
								"color": "orange",
								"value": 75
							},
							{
								"color": "red",
								"value": 90
							}
						]
					}
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"fields": "",
					"values": false
				},
				"orientation": "auto",
				"textMode": "auto",
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "auto"
			}
		},
		{
			"type": "stat",
			"title": "Memory Utilization (used)",
			"datasource": {
				"type": "prometheus",
				"uid": "${DS_PROMETHEUS}"
			},
			"gridPos": {
				"h": 4,
				"w": 6,
				"x": 12,
				"y": 4
			},
			"targets": [
				{
					"expr": "100 * avg({\"system.memory.utilization\", state=\"used\", \"Microsoft.resourceid\"=~\"$resourceId\"})",
					"legendFormat": "",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"decimals": 1,
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "green",
								"value": null
							},
							{
								"color": "orange",
								"value": 80
							},
							{
								"color": "red",
								"value": 90
							}
						]
					}
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"fields": "",
					"values": false
				},
				"orientation": "auto",
				"textMode": "auto",
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "auto"
			}
		},
		{
			"type": "stat",
			"title": "Available Memory",
			"datasource": {
				"type": "prometheus",
				"uid": "${DS_PROMETHEUS}"
			},
			"gridPos": {
				"h": 4,
				"w": 6,
				"x": 18,
				"y": 4
			},
			"targets": [
				{
					"expr": "(sum({\"system.memory.limit\", \"Microsoft.resourceid\"=~\"$resourceId\"}) - sum({\"system.memory.usage\", state=\"used\", \"Microsoft.resourceid\"=~\"$resourceId\"}))",
					"legendFormat": "",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "bytes",
					"decimals": 0
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"fields": "",
					"values": false
				},
				"orientation": "auto",
				"textMode": "auto",
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "auto"
			}
		},
		{
			"type": "timeseries",
			"title": "CPU utilization by state",
			"datasource": {
				"type": "prometheus",
				"uid": "${DS_PROMETHEUS}"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 0,
				"y": 8
			},
			"targets": [
				{
					"expr": "100 * avg by (state) ({\"system.cpu.utilization\", \"Microsoft.resourceid\"=~\"$resourceId\"})",
					"legendFormat": "{{state}}",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"decimals": 1
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "right"
				},
				"tooltip": {
					"mode": "multi"
				}
			}
		},
		{
			"type": "timeseries",
			"title": "Load average (1m / 5m / 15m)",
			"datasource": {
				"type": "prometheus",
				"uid": "${DS_PROMETHEUS}"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 12,
				"y": 8
			},
			"targets": [
				{
					"expr": "{\"system.cpu.load_average.1m\", \"Microsoft.resourceid\"=~\"$resourceId\"}",
					"legendFormat": "1m",
					"refId": "A"
				},
				{
					"expr": "{\"system.cpu.load_average.5m\", \"Microsoft.resourceid\"=~\"$resourceId\"}",
					"legendFormat": "5m",
					"refId": "B"
				},
				{
					"expr": "{\"system.cpu.load_average.15m\", \"Microsoft.resourceid\"=~\"$resourceId\"}",
					"legendFormat": "15m",
					"refId": "C"
				}
			],
			"fieldConfig": {
				"defaults": {
					"decimals": 2
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			}
		},
		{
			"type": "timeseries",
			"title": "Disk throughput (bytes/sec)",
			"datasource": {
				"type": "prometheus",
				"uid": "${DS_PROMETHEUS}"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 0,
				"y": 16
			},
			"targets": [
				{
					"expr": "sum by (device, direction) (rate({\"system.disk.io\", \"Microsoft.resourceid\"=~\"$resourceId\", device=~\"$device\"}[5m]))",
					"legendFormat": "{{device}} {{direction}}",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "Bps",
					"decimals": 1
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "right"
				},
				"tooltip": {
					"mode": "multi"
				}
			}
		},
		{
			"type": "timeseries",
			"title": "Disk operations/sec",
			"datasource": {
				"type": "prometheus",
				"uid": "${DS_PROMETHEUS}"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 12,
				"y": 16
			},
			"targets": [
				{
					"expr": "sum by (device, direction) (rate({\"system.disk.operations\", \"Microsoft.resourceid\"=~\"$resourceId\", device=~\"$device\"}[5m]))",
					"legendFormat": "{{device}} {{direction}}",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "ops",
					"decimals": 1
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "right"
				},
				"tooltip": {
					"mode": "multi"
				}
			}
		},
		{
			"type": "timeseries",
			"title": "Filesystem utilization (%)",
			"datasource": {
				"type": "prometheus",
				"uid": "${DS_PROMETHEUS}"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 0,
				"y": 24
			},
			"targets": [
				{
					"expr": "100 * avg by (mountpoint) ({\"system.filesystem.utilization\", \"Microsoft.resourceid\"=~\"$resourceId\", mountpoint=~\"$mountpoint\"})",
					"legendFormat": "{{mountpoint}}",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"decimals": 1
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "right"
				},
				"tooltip": {
					"mode": "multi"
				}
			}
		},
		{
			"type": "timeseries",
			"title": "Filesystem usage (bytes)",
			"datasource": {
				"type": "prometheus",
				"uid": "${DS_PROMETHEUS}"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 12,
				"y": 24
			},
			"targets": [
				{
					"expr": "sum by (mountpoint, state) ({\"system.filesystem.usage\", \"Microsoft.resourceid\"=~\"$resourceId\", mountpoint=~\"$mountpoint\"})",
					"legendFormat": "{{mountpoint}} {{state}}",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "bytes",
					"decimals": 1
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "right"
				},
				"tooltip": {
					"mode": "multi"
				}
			}
		},
		{
			"type": "timeseries",
			"title": "Network throughput (bytes/sec)",
			"datasource": {
				"type": "prometheus",
				"uid": "${DS_PROMETHEUS}"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 0,
				"y": 32
			},
			"targets": [
				{
					"expr": "sum by (interface, direction) (rate({\"system.network.io\", \"Microsoft.resourceid\"=~\"$resourceId\", interface=~\"$interface\"}[5m]))",
					"legendFormat": "{{interface}} {{direction}}",
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "Bps",
					"decimals": 1
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "right"
				},
				"tooltip": {
					"mode": "multi"
				}
			}
		},
		{
			"type": "timeseries",
			"title": "Network errors & dropped (packets/sec)",
			"datasource": {
				"type": "prometheus",
				"uid": "${DS_PROMETHEUS}"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 12,
				"y": 32
			},
			"targets": [
				{
					"expr": "sum by (interface, direction) (rate({\"system.network.errors\", \"Microsoft.resourceid\"=~\"$resourceId\", interface=~\"$interface\"}[5m]))",
					"legendFormat": "errors {{interface}} {{direction}}",
					"refId": "A"
				},
				{
					"expr": "sum by (interface, direction) (rate({\"system.network.dropped\", \"Microsoft.resourceid\"=~\"$resourceId\", interface=~\"$interface\"}[5m]))",
					"legendFormat": "dropped {{interface}} {{direction}}",
					"refId": "B"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "pps",
					"decimals": 2
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "table",
					"placement": "right"
				},
				"tooltip": {
					"mode": "multi"
				}
			}
		},
		{
			"type": "table",
			"title": "Top processes by CPU utilization",
			"datasource": {
				"type": "prometheus",
				"uid": "${DS_PROMETHEUS}"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 0,
				"y": 40
			},
			"targets": [
				{
					"expr": "topk(10, 100 * sum by (\"process.command\") ({\"process.cpu.utilization\", \"Microsoft.resourceid\"=~\"$resourceId\"}))",
					"legendFormat": "{{process.command}}",
					"refId": "A",
					"format": "table"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percent",
					"decimals": 2
				},
				"overrides": []
			},
			"options": {
				"showHeader": true
			}
		},
		{
			"type": "table",
			"title": "Top processes by memory usage",
			"datasource": {
				"type": "prometheus",
				"uid": "${DS_PROMETHEUS}"
			},
			"gridPos": {
				"h": 8,
				"w": 12,
				"x": 12,
				"y": 40
			},
			"targets": [
				{
					"expr": "topk(10, sum by (\"process.command\") ({\"process.memory.usage\", \"Microsoft.resourceid\"=~\"$resourceId\"}))",
					"legendFormat": "{{process.command}}",
					"refId": "A",
					"format": "table"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "bytes",
					"decimals": 2
				},
				"overrides": []
			},
			"options": {
				"showHeader": true
			}
		}
	],
	"refresh": "30s",
	"schemaVersion": 39,
	"style": "dark",
	"tags": [
		"otel",
		"vm",
		"azure-monitor-workspace",
		"managed-prometheus"
	],
	"templating": {
		"list": [
			{
				"name": "resourceId",
				"type": "query",
				"label": "Resource",
				"hide": 0,
				"datasource": {
					"type": "prometheus",
					"uid": "${DS_PROMETHEUS}"
				},
				"refresh": 1,
				"query": "label_values({\"system.uptime\"}, \"Microsoft.resourceid\")",
				"includeAll": true,
				"allValue": ".*",
				"multi": false,
				"sort": 1,
				"current": {
					"selected": false,
					"text": "All",
					"value": ".*"
				}
			},
			{
				"name": "device",
				"type": "query",
				"label": "Disk device",
				"hide": 0,
				"datasource": {
					"type": "prometheus",
					"uid": "${DS_PROMETHEUS}"
				},
				"refresh": 1,
				"query": "label_values({\"system.disk.io\", \"Microsoft.resourceid\"=~\"$resourceId\"}, device)",
				"includeAll": true,
				"allValue": ".*",
				"multi": true,
				"sort": 1,
				"current": {
					"selected": false,
					"text": "All",
					"value": [
						".*"
					]
				}
			},
			{
				"name": "mountpoint",
				"type": "query",
				"label": "Mount point",
				"hide": 0,
				"datasource": {
					"type": "prometheus",
					"uid": "${DS_PROMETHEUS}"
				},
				"refresh": 1,
				"query": "label_values({\"system.filesystem.usage\", \"Microsoft.resourceid\"=~\"$resourceId\"}, mountpoint)",
				"includeAll": true,
				"allValue": ".*",
				"multi": true,
				"sort": 1,
				"current": {
					"selected": false,
					"text": "All",
					"value": [
						".*"
					]
				}
			},
			{
				"name": "interface",
				"type": "query",
				"label": "Network interface",
				"hide": 0,
				"datasource": {
					"type": "prometheus",
					"uid": "${DS_PROMETHEUS}"
				},
				"refresh": 1,
				"query": "label_values({\"system.network.io\", \"Microsoft.resourceid\"=~\"$resourceId\"}, interface)",
				"includeAll": true,
				"allValue": ".*",
				"multi": true,
				"sort": 1,
				"current": {
					"selected": false,
					"text": "All",
					"value": [
						".*"
					]
				}
			}
		]
	},
	"time": {
		"from": "now-6h",
		"to": "now"
	},
	"timepicker": {
		"refresh_intervals": [
			"5s",
			"10s",
			"30s",
			"1m",
			"5m",
			"15m",
			"30m",
			"1h"
		]
	},
	"timezone": "browser",
	"title": "VM Insights (OpenTelemetry) - System & Process",
	"uid": "vm-otel-system-process",
	"version": 1,
	"weekStart": ""
}
